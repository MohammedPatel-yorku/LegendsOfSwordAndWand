@startuml Component_Diagram
skinparam componentStyle rectangle

component "Controller" as CTRL {
  interface "HTTP Routes" as HTTP
}

component "Service Layer" as SVC {
  interface "IBattleService" as IBS
  interface "ICampaignService" as ICS
  interface "IHeroService" as IHS
  interface "IInnService" as IIS
  interface "IAuthService" as IAS
  interface "IUserService" as IUS
  interface "IProfileService" as IPS
  interface "IPvPService" as IPVP
  interface "IInventoryService" as IINV
  interface "IPartyService" as IPTY
}

component "Battle Engine" as BATTLE {
  interface "BattleState" as BS
  interface "AbilityFactory" as AF
  interface "BattleInitializer" as BI
  interface "ClassBonusStrategy" as CBS
}

component "Model" as MODEL {
  interface "JPA Entities" as JPA
}

component "Repository" as REPO {
  interface "JpaRepository" as JPAREPO
}

component "Config" as CFG {
  interface "SecurityFilterChain" as SEC
}

database "MySQL" as DB

CTRL --> SVC : uses interfaces
SVC --> BATTLE : delegates battle logic
SVC --> REPO : persists via repositories
BATTLE --> MODEL : reads/mutates entities
REPO --> MODEL : maps entities
REPO --> DB : SQL via JPA
CFG --> SVC : injects via Spring
CTRL ..> CFG : secured by

@enduml