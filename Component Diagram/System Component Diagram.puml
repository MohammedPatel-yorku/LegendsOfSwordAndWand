@startuml

title Legends of Sword and Wand - Component Diagram

package "Presentation Layer" {
    [UserController]
    [CampaignController]
    [BattleController]
}

package "Application Layer" {
    [UserService]
    [CampaignService]
    [BattleService]
    [HeroService]
    [PartyService]
}

package "Persistence Layer" {
    [UserRepository]
    [HeroRepository]
    [PartyRepository]
    [CampaignRepository]
}

database "MySQL Database"

[UserController] --> [UserService]
[CampaignController] --> [CampaignService]
[BattleController] --> [BattleService]

[CampaignService] --> [HeroService]
[CampaignService] --> [PartyService]
[CampaignService] --> [BattleService]

[UserService] --> [UserRepository]
[HeroService] --> [HeroRepository]
[PartyService] --> [PartyRepository]
[CampaignService] --> [CampaignRepository]

[UserRepository] --> "MySQL Database"
[HeroRepository] --> "MySQL Database"
[PartyRepository] --> "MySQL Database"
[CampaignRepository] --> "MySQL Database"

@enduml