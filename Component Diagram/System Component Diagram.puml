@startuml Component_Diagram_Simple
skinparam componentStyle rectangle
skinparam linetype ortho

package "Presentation Layer" {
  component "Controllers" as CTRL
  component "Security Config" as CFG
}

package "Service Layer" {
  component "Service Interfaces\n& Implementations" as SVC
}

package "Battle Engine" {
  component "Battle Initializer\n(Template Method)" as BINIT
  component "Ability System\n(Factory + Decorator)" as ABLS
  component "Class Bonus Strategies\n(Strategy)" as STRAT
  component "Battle State" as BSTATE
}

package "Data Layer" {
  component "Repositories\n(JPA)" as REPO
  database "MySQL" as DB
}

package "Model" {
  component "JPA Entities\n(Builder)" as MODEL
}

CFG --> CTRL : secures
CTRL --> SVC : calls
SVC --> BINIT
SVC --> ABLS
SVC --> STRAT
SVC --> BSTATE
SVC --> REPO
REPO --> MODEL
REPO --> DB

@enduml