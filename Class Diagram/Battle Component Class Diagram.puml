@startuml
'https://plantuml.com/class-diagram

title Battle Component - Class Diagram

class Battle {
    - Long id
    - Party partyA
    - Party partyB
    - Queue<Hero> turnOrder
    + startBattle()
    + executeTurn()
    + determineWinner(): Party
}

interface ActionStrategy {
    + execute(Hero actor, Hero target)
}

class AttackStrategy {
    + execute(Hero actor, Hero target)
}

class DefendStrategy {
    + execute(Hero actor, Hero target)
}

class CastSpellStrategy {
    + execute(Hero actor, Hero target)
}

interface IBattleService {
    + initiateBattle(Party p1, Party p2): Battle
    + performAction(Hero actor, ActionStrategy strategy, Hero target)
}

Battle --> Party
Battle --> Hero
BattleService ..|> IBattleService
BattleService --> Battle
AttackStrategy ..|> ActionStrategy
DefendStrategy ..|> ActionStrategy
CastSpellStrategy ..|> ActionStrategy

@enduml