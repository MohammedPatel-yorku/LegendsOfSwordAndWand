@startuml
'https://plantuml.com/class-diagram

title Hero Creation - Factory Pattern

class HeroFactory {
    + createHero(type : HeroClass, name : String) : Hero
}

abstract class Hero {
    - name : String
    - health : int
}

class Warrior
class Mage
class Rogue

Hero <|-- Warrior
Hero <|-- Mage
Hero <|-- Rogue

HeroFactory --> Hero

@enduml