@startuml
autonumber

skinparam responseMessageBelowArrow true

title Use Case 4 - Interact with the Inn (Updated)

actor User
boundary InnController
control ICampaignService
control IInnService
control IPartyManagementService
database PartyRepository
control IHeroService
database ItemRepository
database InventoryRepository

== Display Inn View ==
User -> InnController: Get /inn
activate InnController
InnController -> ICampaignService: getActiveCampaign(username)
activate ICampaignService
ICampaignService --> InnController: campaign
deactivate ICampaignService
InnController -> IInnService: loadInnView(campaignId)
activate IInnService

IInnService -> IPartyManagementService: reviveAndHealParty(campaignId)
activate IPartyManagementService
IPartyManagementService -> PartyRepository: save(party)
activate PartyRepository
PartyRepository --> IPartyManagementService: saved party
deactivate PartyRepository
IPartyManagementService --> IInnService: revived and healed party
deactivate IPartyManagementService
IInnService --> InnController: heal summary

InnController -> IInnService: getAvailableRecruits(campaignId)
IInnService -> IInnService: cleanupTemporaryRecruits(campaignId)
IInnService -> IPartyManagementService: getActiveParty(campaignId)
activate IPartyManagementService
IPartyManagementService --> IInnService: active party
deactivate IPartyManagementService
IInnService -> IInnService: Generate recruits
IInnService --> InnController: available recruits

InnController -> IInnService: getShopItems()
IInnService --> InnController: items
deactivate IInnService

InnController -> IHeroService: isLevelUpPending(heroId)
activate IHeroService
IHeroService --> InnController: heroes with pending level ups
deactivate IHeroService

InnController --> User: Display inn page
deactivate InnController

==Interact with Inn==

loop While User in Inn
    alt Buy Item
        User -> InnController: Post /buy (itemId)
        activate InnController
        InnController -> IInnService: purchaseItem(campaignId, itemId)
        activate IInnService
        IInnService -> ItemRepository: findById(itemId)
        activate ItemRepository
        ItemRepository --> IInnService: Optional item
        deactivate ItemRepository

        IInnService -> IPartyManagementService: deductGold(partyId, itemCost)
        IInnService -> InventoryRepository: save(inventory)
        IInnService --> InnController: true
        deactivate IInnService

        InnController --> User: Item purchased

    else Recruit Hero
        InnController -> IInnService: recruitHero(campaignId, heroId)
        activate IInnService
        IInnService -> IHeroService: findById(heroToRecruit)
        activate IHeroService
        IHeroService --> IInnService: hero
        IInnService -> IHeroService: save(hero)
        deactivate IHeroService
        IInnService -> IPartyManagementService: deductGold(partyId, heroCost)

        IInnService --> InnController: true
        deactivate IInnService
        InnController --> User: Hero recruited
end

==Exit Inn==
User -> InnController: Post /continue
InnController -> IInnService: cleanupTemporaryRecruits(campaignId)
InnController --> User: redirect /campaign
deactivate InnController

@enduml
