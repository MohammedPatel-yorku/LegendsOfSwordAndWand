@startuml
''autonumber each message
autonumber

skinparam responseMessageBelowArrow true

title Use Case 1 - User Registration and Login (Updated)

actor User
boundary UserController
control UserService
database UserRepository
collections PasswordEncoder

== Registration ==

User -> UserController: Enter username and password
activate UserController

UserController -> UserService: registerUser(username, password)
activate UserService

UserService -> UserService: validate(username, password)

alt Invalid Input
    UserService --> UserController: throw new IllegalArgumentException

else Valid Input
    UserService -> UserRepository: findByUsername(username)
    activate UserRepository

    alt Username Already Exists
        UserRepository --> UserService: existing user
        deactivate UserRepository
        UserService --> UserController: throw new UsernameAlreadyExistsException

    else Username Available
        UserRepository --> UserService: null
        deactivate UserRepository

        UserService -> PasswordEncoder: encode(password)
        activate PasswordEncoder
        PasswordEncoder --> UserService: hashedPassword
        deactivate PasswordEncoder

        UserService -> UserRepository: save(User)
        activate UserRepository
        UserRepository --> UserService: User saved
        deactivate UserRepository

        UserService --> UserController: "Registration successful."
    end
end

deactivate UserService
UserController --> User: Display registration message
deactivate UserController


== Login ==

User -> UserController: Enter username and password
activate UserController

UserController -> UserService: loginUser(username, password)
activate UserService

UserService -> UserRepository: findByUsername(username)
activate UserRepository

alt User Not Found
    UserRepository --> UserService: null
    deactivate UserRepository
    UserService --> UserController: throw new UserNotFoundException

else User Found
    UserRepository --> UserService: User
    deactivate UserRepository

    UserService -> PasswordEncoder: matches(password, storedHash)
    activate PasswordEncoder

    alt Password Incorrect
        PasswordEncoder --> UserService: false
        deactivate PasswordEncoder
        UserService --> UserController: throw new IncorrectPasswordException

    else Password Correct
        PasswordEncoder --> UserService: true
        deactivate PasswordEncoder
        UserService --> UserController: "Login successful."
    end
end

deactivate UserService
UserController --> User: Display login message
deactivate UserController

@enduml
