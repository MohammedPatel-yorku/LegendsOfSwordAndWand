@startuml
''autonumber each message
autonumber

skinparam responseMessageBelowArrow true

title Use Case 1 - User Registration and Login (Updated)

actor User
boundary UserController
control IUserService
database UserRepository
collections PasswordEncoder

== Registration ==

User -> UserController: Enter username and password
activate UserController

UserController -> IUserService: registerUser(username, password)
activate IUserService

IUserService -> IUserService: validate(username, password)

alt Invalid Input
    IUserService --> UserController: throw new IllegalArgumentException

else Valid Input
    IUserService -> UserRepository: findByUsername(username)
    activate UserRepository

    alt Username Already Exists
        UserRepository --> IUserService: existing user
        deactivate UserRepository
        IUserService --> UserController: throw new UsernameAlreadyExistsException

    else Username Available
        UserRepository --> IUserService: null
        deactivate UserRepository

        IUserService -> PasswordEncoder: encode(password)
        activate PasswordEncoder
        PasswordEncoder --> IUserService: hashedPassword
        deactivate PasswordEncoder

        IUserService -> UserRepository: save(User)
        activate UserRepository
        UserRepository --> IUserService: User saved
        deactivate UserRepository

        IUserService --> UserController: "Registration successful."
    end
end

deactivate IUserService
UserController --> User: Display registration message
deactivate UserController


== Login ==

User -> UserController: Enter username and password
activate UserController

UserController -> IUserService: loginUser(username, password)
activate IUserService

IUserService -> UserRepository: findByUsername(username)
activate UserRepository

alt User Not Found
    UserRepository --> IUserService: null
    deactivate UserRepository
    IUserService --> UserController: throw new UserNotFoundException

else User Found
    UserRepository --> IUserService: User
    deactivate UserRepository

    IUserService -> PasswordEncoder: matches(password, storedHash)
    activate PasswordEncoder

    alt Password Incorrect
        PasswordEncoder --> IUserService: false
        deactivate PasswordEncoder
        IUserService --> UserController: throw new IncorrectPasswordException

    else Password Correct
        PasswordEncoder --> IUserService: true
        deactivate PasswordEncoder
        IUserService --> UserController: "Login successful."
    end
end

deactivate IUserService
UserController --> User: Display login message
deactivate UserController

@enduml
