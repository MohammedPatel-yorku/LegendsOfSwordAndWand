@startuml
autonumber

skinparam responseMessageBelowArrow true

title Use Case 1 - User Registration and Login (Updated)

actor User
boundary AuthController
control IAuthService
control CustomUserDetailsService
database UserRepository
collections PasswordEncoder

== Registration ==

User -> AuthController: POST /register (username, password)
activate AuthController

AuthController -> IAuthService: register(RegisterRequest)
activate IAuthService

IAuthService -> UserRepository: existsByUsername(username)
activate UserRepository

alt Username Already Taken
    UserRepository --> IAuthService: true
    IAuthService --> AuthController: throw RuntimeException("Username already exists")
    AuthController --> User: Redirect /register with error message

else Username Available
    UserRepository --> IAuthService: false
    deactivate UserRepository

    IAuthService -> PasswordEncoder: encode(password)
    activate PasswordEncoder
    PasswordEncoder --> IAuthService: hashedPassword
    deactivate PasswordEncoder

    IAuthService -> UserRepository: save(User)
    activate UserRepository
    UserRepository --> IAuthService: saved User
    deactivate UserRepository

    IAuthService --> AuthController: saved User
    deactivate IAuthService
    AuthController --> User: Redirect /login
    deactivate AuthController
end


== Login ==

User -> AuthController: POST /login (username, password)
activate AuthController

AuthController -> CustomUserDetailsService: loadUserByUsername(username)
activate CustomUserDetailsService

CustomUserDetailsService -> UserRepository: findByUsername(username)
activate UserRepository

alt User Not Found
    UserRepository --> CustomUserDetailsService: empty Optional
    CustomUserDetailsService --> AuthController: throw UsernameNotFoundException
    AuthController --> User: Redirect /login?error

else User Found
    UserRepository --> CustomUserDetailsService: User
    deactivate UserRepository

    CustomUserDetailsService --> AuthController: UserDetails
    deactivate CustomUserDetailsService

    AuthController -> PasswordEncoder: matches(rawPassword, hashedPassword)
    activate PasswordEncoder

    alt Password Incorrect
        PasswordEncoder --> AuthController: false
        AuthController --> User: Redirect /login?error

    else Password Correct
        PasswordEncoder --> AuthController: true
        deactivate PasswordEncoder
        AuthController --> User: Redirect /dashboard
        deactivate AuthController
    end
end


@enduml