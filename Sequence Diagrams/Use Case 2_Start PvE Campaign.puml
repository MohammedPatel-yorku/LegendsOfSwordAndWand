@startuml
autonumber

skinparam responseMessageBelowArrow true

title Use Case 2 - Start PvE Campaign (Updated)

actor User
boundary CampaignController
control ICampaignService
control ICampaignProgressService
control IInventoryService
database CampaignRepository
database PartyRepository
database HeroRepository
database InventoryRepository

== Start New Campaign ==

User -> CampaignController: POST /campaign/new (heroName, heroClass)
activate CampaignController

CampaignController -> ICampaignService: startNewCampaign(username, heroName, heroClass)
activate ICampaignService

ICampaignService -> PartyRepository: save(new Party)
activate PartyRepository
PartyRepository --> ICampaignService: saved Party
deactivate PartyRepository

ICampaignService -> HeroRepository: save(new Hero with class bonus)
activate HeroRepository
HeroRepository --> ICampaignService: saved Hero
deactivate HeroRepository

ICampaignService -> InventoryRepository: save(new Inventory)
activate InventoryRepository
InventoryRepository --> ICampaignService: saved Inventory
deactivate InventoryRepository

ICampaignService -> CampaignRepository: save(new Campaign, active=true, room=0)
activate CampaignRepository
CampaignRepository --> ICampaignService: saved Campaign
deactivate CampaignRepository

ICampaignService --> CampaignController: Campaign
deactivate ICampaignService

CampaignController --> User: Redirect /campaign
deactivate CampaignController

== View Campaign Page (Party, Inventory, Room) ==

User -> CampaignController: GET /campaign
activate CampaignController

CampaignController -> ICampaignProgressService: getCampaignViewData(username)
activate ICampaignProgressService
ICampaignProgressService -> CampaignRepository: findActiveCampaignByUsername(username)
activate CampaignRepository
CampaignRepository --> ICampaignProgressService: Campaign
deactivate CampaignRepository
ICampaignProgressService --> CampaignController: CampaignViewInfo (heroes, gold, currentRoom)
deactivate ICampaignProgressService

CampaignController -> IInventoryService: getPartyInventoryItems(campaignId)
activate IInventoryService
IInventoryService -> InventoryRepository: findByPartyId(partyId)
activate InventoryRepository
InventoryRepository --> IInventoryService: Inventory
deactivate InventoryRepository
IInventoryService --> CampaignController: List<Item>
deactivate IInventoryService

CampaignController --> User: Show campaign page (room, heroes, gold, inventory)
deactivate CampaignController

== Visit Next Room ==

User -> CampaignController: POST /campaign/next-room
activate CampaignController

CampaignController -> ICampaignProgressService: enterNextRoom(username)
activate ICampaignProgressService

ICampaignProgressService -> CampaignRepository: findActiveCampaignByUsername(username)
activate CampaignRepository
CampaignRepository --> ICampaignProgressService: Campaign
deactivate CampaignRepository

ICampaignProgressService -> CampaignRepository: save(campaign, roomPending=true, currentRoom++)
activate CampaignRepository
CampaignRepository --> ICampaignProgressService: saved Campaign
deactivate CampaignRepository

alt Battle Room
    ICampaignProgressService --> CampaignController: RoomType.BATTLE
    CampaignController --> User: Redirect /battle
    note right: See Use Case 3 - Single Battle

else Inn Room
    ICampaignProgressService --> CampaignController: RoomType.INN
    deactivate ICampaignProgressService
    CampaignController --> User: Redirect /inn
    deactivate CampaignController
    note right: See Use Case 4 - Interact With Inn
end


== Campaign Completion (Room 30 Cleared) ==

User -> CampaignController: POST /battle/continue or /inn/leave
activate CampaignController

CampaignController -> ICampaignService: completeCampaign(username)
activate ICampaignService

ICampaignService -> ICampaignProgressService: calculateAndPersistScore(campaign)
activate ICampaignProgressService
ICampaignProgressService -> CampaignRepository: save(campaign, score=calculated)
activate CampaignRepository
CampaignRepository --> ICampaignProgressService: saved
deactivate CampaignRepository
ICampaignProgressService --> ICampaignService: score
deactivate ICampaignProgressService

ICampaignService -> CampaignRepository: save(campaign, active=false)
activate CampaignRepository
CampaignRepository --> ICampaignService: saved Campaign
deactivate CampaignRepository

ICampaignService --> CampaignController: completed Campaign
deactivate ICampaignService

CampaignController --> User: Redirect /campaign/complete
deactivate CampaignController

== Save Party After Completion ==

User -> CampaignController: GET /campaign/complete
activate CampaignController
CampaignController --> User: Show completion page (score, heroes, save options)
deactivate CampaignController

alt Less Than 5 Saved Parties

    alt User Chooses to Save
        User -> CampaignController: POST /campaign/complete/save (campaignId)
        activate CampaignController
        CampaignController -> ICampaignService: savePartyFromCampaign(campaignId, userId)
        activate ICampaignService
        ICampaignService -> PartyRepository: save(party, saved=true)
        activate PartyRepository
        PartyRepository --> ICampaignService: saved Party
        deactivate PartyRepository
        ICampaignService --> CampaignController: done
        deactivate ICampaignService
        CampaignController --> User: Redirect /dashboard
        deactivate CampaignController

    else User Discards
        User -> CampaignController: POST /campaign/complete/discard
        activate CampaignController
        CampaignController --> User: Redirect /dashboard
        deactivate CampaignController
    end

else 5 Saved Parties

    alt User Chooses to Replace
        User -> CampaignController: POST /campaign/complete/replace (campaignId, replacePartyId)
        activate CampaignController
        CampaignController -> ICampaignService: replacePartyFromCampaign(campaignId, userId, replacePartyId)
        activate ICampaignService
        ICampaignService -> PartyRepository: delete(partyToReplace)
        activate PartyRepository
        PartyRepository --> ICampaignService: deleted
        deactivate PartyRepository
        ICampaignService -> PartyRepository: save(party, saved=true)
        activate PartyRepository
        PartyRepository --> ICampaignService: saved Party
        deactivate PartyRepository
        ICampaignService --> CampaignController: done
        deactivate ICampaignService
        CampaignController --> User: Redirect /dashboard
        deactivate CampaignController

    else User Discards
        User -> CampaignController: POST /campaign/complete/discard
        activate CampaignController
        CampaignController --> User: Redirect /dashboard
        deactivate CampaignController
    end

end

@enduml