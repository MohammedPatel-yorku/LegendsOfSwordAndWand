@startuml
title Use Case 6 - Continue Incomplete PvE Campaign

autonumber

actor User
boundary CampaignController
control CampaignService
database CampaignRepository
control HeroService
database HeroRepository

User -> CampaignController : Select "Continue Campaign"
activate CampaignController

CampaignController -> CampaignService : resumeCampaign(userId)
activate CampaignService

CampaignService -> CampaignRepository : findByUserId(userId)
activate CampaignRepository
CampaignRepository --> CampaignService : return Campaign entity
deactivate CampaignRepository

CampaignService -> HeroService: getHeroes(campaignId)
activate HeroService
HeroService -> HeroRepository : findHeroesByCampaignId(id)
activate HeroRepository
HeroRepository --> HeroService : return List<Hero>
deactivate HeroRepository
HeroService --> CampaignService: return heroes
deactivate HeroService

CampaignService --> CampaignController : return loaded campaign
deactivate CampaignService

CampaignController --> User : Display Campaign/Inn View
deactivate CampaignController

@enduml