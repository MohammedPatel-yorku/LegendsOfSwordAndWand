@startuml
'https://plantuml.com/sequence-diagram

@startuml
'autonumber

title Use Case 4 - Interact with the Inn (Campaign specific)

actor User
boundary InnController
control InnService
control PartyService
control InventoryService
database PartyRepository
database InventoryRepository

User -> InnController: Enter Inn (campaignId)
activate InnController

InnController -> InnService: loadInnView(campaignId)
activate InnService

InnService -> PartyService: reviveAndHealParty(campaignId)
activate PartyService
PartyService -> PartyRepository: updatePartyStatus(campaignId)
activate PartyRepository

PartyRepository --> PartyService: Party updated
deactivate PartyRepository
deactivate PartyService

InnService --> InnController: Display party status

loop While User in Inn
    User -> InnController: Select Inn action;

    alt Buy Item
        InnController -> InventoryService: purchaseItem(campaignId, itemId)
        activate InventoryService
        InventoryService -> PartyService: getActiveParty(campaignId)
        activate PartyService
        PartyService -> PartyRepository: findActivePartyByCampaignId(campaignId)
        activate PartyRepository
        PartyRepository --> PartyService: Party returned
        deactivate PartyRepository
        PartyService --> InventoryService: Party with id (partyId)
        deactivate PartyService

        InventoryService -> InventoryRepository: saveInventory(partyId, itemId)
        activate InventoryRepository

        InventoryRepository --> InventoryService: Inventory saved
        deactivate InventoryRepository
        InventoryService --> InnController: Purchase successful
        deactivate InventoryService

    else Recruit Hero
        InnController -> PartyService: recruitHero(campaignId, heroId)
        activate PartyService
        PartyService -> PartyRepository: saveParty(campaignId)
        activate PartyRepository

        PartyRepository --> PartyService: Party saved
        deactivate PartyRepository
        PartyService --> InnController: Hero recruited
        deactivate PartyService

    else Leave Inn
        InnController --> User: Exit Inn
    end
end

InnController -> InnService: exitInn(campaignId)
InnService -> PartyRepository: savePartyState(campaignId)
activate PartyRepository

PartyRepository --> InnService: Party state saved
deactivate PartyRepository

InnService --> InnController: Proceed to next room
deactivate InnService

InnController --> User: Show campaign view
deactivate InnController

@enduml
