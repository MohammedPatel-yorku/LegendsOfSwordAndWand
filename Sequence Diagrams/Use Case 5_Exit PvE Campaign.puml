@startuml
'https://plantuml.com/sequence-diagram

autonumber

skinparam responseMessageBelowArrow true

title Use Case 5 - Exit PvE Campaign (Updated)

actor User

boundary CampaignController
control ICampaignService

User -> CampaignController: Select "Save and Exit Campaign"
activate CampaignController

alt Currently in Battle
    CampaignController --> User: error("Cannot exit during battle")

else Exit Allowed
    CampaignController -> ICampaignService: exitCampaign(campaignId)
    activate ICampaignService
    ICampaignService --> CampaignController: saved campaign
    deactivate ICampaignService

    CampaignController --> User: redirect /dashboard
    deactivate CampaignController

end

@enduml