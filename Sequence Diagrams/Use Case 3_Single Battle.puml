@startuml
'https://plantuml.com/sequence-diagram

autonumber

title Use Case 3 - Single Battle

actor User

boundary BattleController
control BattleService
control TurnManager
control AbilityExecutor
control DamageCalculator
entity Battle
database BattleRepository

== Initialize Battle ==

User -> BattleController: startBattle(partyA, partyB)
activate BattleController

BattleController -> BattleService: initializeBattle(partyA, partyB)
activate BattleService

BattleService -> Battle: createBattle(partyA, partyB)
activate Battle
Battle --> BattleService: Battle Instance
deactivate Battle

BattleService -> TurnManager: determineFirstTurn(battleInstance)
activate TurnManager
TurnManager --> BattleService: First Active Unit
deactivate TurnManager

BattleService --> BattleController: Battle Initialized
deactivate BattleService

== Battle Loop ==

loop Until One Party Defeated

    BattleController -> BattleService: getActiveUnit()
    activate BattleService
    BattleService --> BattleController: Active Unit
    deactivate BattleService

    User -> BattleController: selectAbility(target)

    BattleController -> BattleService: executeTurn(ability, target)
    activate BattleService

    BattleService -> AbilityExecutor: execute(ability, attacker, target)
    activate AbilityExecutor

    AbilityExecutor -> DamageCalculator: calculateDamage(attacker, target)
    activate DamageCalculator
    DamageCalculator --> AbilityExecutor: Damage Value
    deactivate DamageCalculator

    AbilityExecutor --> BattleService: Action Result
    deactivate AbilityExecutor

    BattleService -> TurnManager: nextTurn()
    activate TurnManager
    TurnManager --> BattleService: Next Active Unit
    deactivate TurnManager

    BattleService --> BattleController: Turn Resolved
    deactivate BattleService

end

== Battle End ==

BattleController -> BattleService: finalizeBattle()
activate BattleService

BattleService -> Battle: determineWinner()
activate Battle
Battle --> BattleService: Battle Result
deactivate Battle

BattleService -> BattleRepository: save(battleResult)
activate BattleRepository
BattleRepository --> BattleService: saved
deactivate BattleRepository

BattleService --> BattleController: return battleResult
deactivate BattleService

BattleController --> User: Display Result
deactivate BattleController

@enduml