@startuml
autonumber

skinparam responseMessageBelowArrow true

title Use Case 3 - Single Battle (Updated)

actor User
boundary BattleController
control ICampaignService
database CampaignRepository
control IBattleService
entity DamageCalculator
entity AbilityHelper
entity AbilityExecutor
entity AbilityFactory
control IHeroService
control IPartyManagementService

== Initialize Battle ==
User -> BattleController: GET /battle
activate BattleController
BattleController -> ICampaignService: getActiveCampaign(username)
activate ICampaignService
ICampaignService -> CampaignRepository: findActiveCampaignByUsername(username)
activate CampaignRepository

CampaignRepository --> ICampaignService: Optional active campaign
deactivate CampaignRepository
ICampaignService --> BattleController: Active campaign

BattleController -> ICampaignService: getPartyCumulativeLevel(username)
ICampaignService --> BattleController: Party cumulative level
deactivate ICampaignService

BattleController -> IBattleService: initializePvEBattle(campaignId, partyCumulativeLevel) or initializePvPBattle
activate IBattleService
IBattleService --> BattleController: return BattleState
deactivate IBattleService
BattleController --> User: Battle session
deactivate BattleController

== Battle Loop ==
loop While Either Party Has a Living Hero
    alt Player Turn
        User -> BattleController: Post /action ActionType
        activate BattleController
        BattleController -> IBattleService: executePlayerAction(battleState, action, targetBattleId, abilityIndex)
        activate IBattleService

        alt Attack
            IBattleService -> IBattleService: executeAttack(attacker, defender, battleState)
            IBattleService -> DamageCalculator: calculateDamage(attacker.attack, defender.defense)
            DamageCalculator --> IBattleService: damage

            IBattleService -> AbilityHelper: applyDamage(attacker, defender, damage, battleState)

        else Defend
            IBattleService -> IBattleService: executeDefend(hero)

        else Wait
            IBattleService -> IBattleService: advanceTurn(battleState)

        else Cast
            IBattleService -> AbilityExecutor: executeAbility(actor, target, allies, enemies, battleState, abilityIndex)
            AbilityExecutor -> AbilityFactory: resolve(effectiveClass, hybridClass, abilityIndex)
            AbilityFactory --> AbilityExecutor: ability

        end
        IBattleService --> BattleController: Updated Battle State

    else Enemy AI Turn
        User -> BattleController: Post /action
        BattleController -> IBattleService: executeEnemyTurn(battleState)
        IBattleService -> IBattleService: decideEnemyAction(actor, targets, battleState)

        IBattleService --> BattleController: Updated Battle State
        deactivate IBattleService

    end
    BattleController --> User: Update Battle Session
    deactivate BattleController

end

== Battle End ==
User -> BattleController: Get /result
activate BattleController
alt Player Win
    BattleController -> IBattleService: awardBattleRewards(battleState)
    activate IBattleService
    IBattleService -> IHeroService: addExperience(heroId, xp) for each hero
    activate IHeroService
    IHeroService --> IBattleService: saved hero
    deactivate IHeroService

    IBattleService -> IPartyManagementService: getActiveParty(campaignId)
    activate IPartyManagementService
    IPartyManagementService --> IBattleService: active party
    IBattleService -> IPartyManagementService: addGold(partyId, gold)
    deactivate IPartyManagementService

else Player Loss
    BattleController -> IBattleService: applyBattleLoss(battleState)
    IBattleService -> IHeroService: Update experience for all heroes
    activate IHeroService
    IHeroService --> IBattleService: saved hero
    deactivate IHeroService

    IBattleService -> IPartyManagementService: getActiveParty(campaignId)
    activate IPartyManagementService
    IPartyManagementService --> IBattleService: active party
    IBattleService -> IPartyManagementService: deductGold(partyId, gold)
    deactivate IPartyManagementService
    deactivate IBattleService

end

BattleController --> User: Display results

@enduml